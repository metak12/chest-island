<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chest Island" Width="1010" Height="650" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#141518" Foreground="#F2F0EC" FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A8A8AC"/>
  <SolidColorBrush x:Key="Line" Color="#37383D"/>
  <SolidColorBrush x:Key="Accent" Color="#CCB5FF"/>
  <Style TargetType="Button">
   <Setter Property="Height" Value="39"/>
   <Setter Property="Padding" Value="13,0"/>
   <Setter Property="Foreground" Value="#F2F0EC"/>
   <Setter Property="Background" Value="#2A2B30"/>
   <Setter Property="BorderBrush" Value="#3B3C42"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value=".82"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value=".64"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#E8DDFC"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="11,0"/>
   <Setter Property="FontSize" Value="13"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#303136"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="SidebarIcon" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="Width" Value="27"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Background" Value="#1D1E22"/>
   <Setter Property="BorderBrush" Value="#37383D"/>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#C7C6CA"/>
   <Setter Property="Background" Value="#1D1E22"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" BorderBrush="#37383D" BorderThickness="0,0,0,1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
       <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#CCB5FF"/><Setter Property="Foreground" Value="#F2F0EC"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#F2F0EC"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F2F0EC"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="OptionSurface" Padding="{TemplateBinding Padding}" Background="#25262B" CornerRadius="5">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="#3C3449"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="#423751"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F2F0EC"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border CornerRadius="7" Background="#26272C" BorderBrush="#44454C" BorderThickness="1">
           <Path Data="M0,0 L4,4 L8,0" Stroke="#CBC7CF" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
          </Border>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter Margin="10,0,28,0" IsHitTestVisible="False" VerticalAlignment="Center"
                         Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
       <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
        <Border MinWidth="{TemplateBinding ActualWidth}" Background="#25262B" BorderBrush="#44454C" BorderThickness="1" CornerRadius="7" Padding="3">
         <ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>

 <Grid x:Name="Dashboard">
  <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#1C1D21" BorderBrush="#303135" BorderThickness="0,0,1,0">
   <DockPanel Margin="14,22,14,14">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="3,0,0,27">
      <Image x:Name="BrandIcon" Width="33" Height="33" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="Chest Island" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
     <Border CornerRadius="9" Background="#303037" Height="39" Padding="11,0" Margin="0,0,0,3">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="&#xE80F;" Style="{StaticResource SidebarIcon}" Foreground="{StaticResource Accent}"/>
       <TextBlock Text="Обзор" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
      </StackPanel>
     </Border>
     <Button x:Name="History" Style="{StaticResource SidebarButton}" AutomationProperties.Name="История" Margin="0,0,0,3">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource SidebarIcon}"/><TextBlock Text="История"/></StackPanel>
     </Button>
     <Button x:Name="DiagnosticsButton" Style="{StaticResource SidebarButton}" AutomationProperties.Name="Диагностика" Margin="0,0,0,3">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource SidebarIcon}"/><TextBlock Text="Диагностика"/></StackPanel>
     </Button>
     <Button x:Name="SettingsButton" Style="{StaticResource SidebarButton}" AutomationProperties.Name="Настройки">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource SidebarIcon}"/><TextBlock Text="Настройки"/></StackPanel>
     </Button>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Height="1" Background="#35363B" Margin="3,0,3,7"/>
     <Button x:Name="UpdateButton" Style="{StaticResource SidebarButton}" FontSize="12" Content="Проверить обновления"/>
     <TextBlock x:Name="Version" Margin="11,4,0,0" FontSize="11" Foreground="{StaticResource Muted}"/>
    </StackPanel>
    <Grid/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="29,23,29,17">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,19">
    <Border DockPanel.Dock="Right" CornerRadius="15" BorderThickness="1" BorderBrush="#3A4340" Background="#232A28" Padding="11,6" VerticalAlignment="Center">
     <TextBlock x:Name="Game" FontSize="12" Foreground="#B9DDCB" Text="Fortnite закрыт"/>
    </Border>
    <TextBlock Text="Счётчик сундуков" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
   <Border Grid.Row="1" CornerRadius="17" BorderBrush="#52465F" BorderThickness="1" Margin="0,0,0,15">
    <Border.Background>
     <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2D263B" Offset="0"/>
      <GradientStop Color="#272334" Offset=".49"/>
      <GradientStop Color="#1D1C24" Offset="1"/>
     </LinearGradientBrush>
    </Border.Background>
    <Grid Margin="23,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
      <TextBlock Text="Всего открыто" Foreground="#D7CEE4" FontSize="14"/>
      <TextBlock x:Name="Count" Text="0" FontSize="70" FontWeight="SemiBold" Margin="0,-3,0,0" RenderTransformOrigin=".5,.5">
       <TextBlock.RenderTransform><ScaleTransform/></TextBlock.RenderTransform>
      </TextBlock>
      <TextBlock x:Name="Session" Foreground="#CDC4DA" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>
      <Button x:Name="EditCount" Content="Изменить счёт" HorizontalAlignment="Left" Height="34" Background="#3C324D" BorderBrush="#5D4C72"/>
     </StackPanel>
     <Border Grid.Column="1" Padding="17" Margin="0,10,0,10" VerticalAlignment="Center" Background="#302A3B" CornerRadius="13" BorderThickness="1" BorderBrush="#4C425A">
      <StackPanel>
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE81D;" Style="{StaticResource SidebarIcon}" Foreground="{StaticResource Accent}"/>
        <TextBlock Text="Личная цель" FontSize="15" FontWeight="SemiBold"/>
       </StackPanel>
       <TextBlock x:Name="GoalLabel" Text="Цель не задана" Foreground="#D8CDE7" FontSize="13" Margin="0,11,0,8" TextWrapping="Wrap"/>
       <ProgressBar x:Name="GoalProgress" Height="5" Maximum="1" Foreground="#C9AAFF" Background="#4D425B" BorderThickness="0" Visibility="Collapsed" Margin="0,0,0,4"/>
       <Button x:Name="EditGoal" Content="Задать цель" Height="33" Margin="0,5,0,0" HorizontalAlignment="Left" Background="#3C324D" BorderBrush="#5D4C72"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#202125" CornerRadius="13" BorderBrush="#35363A" BorderThickness="1" Padding="15" Margin="0,0,6,0">
     <StackPanel>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="&#xE721;" Style="{StaticResource SidebarIcon}" Foreground="#C5ACEF"/>
       <TextBlock Text="Распознавание" FontSize="15" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock x:Name="LiveStatus" Foreground="{StaticResource Muted}" Margin="0,5,0,10" FontSize="12"/>
      <Button x:Name="LiveToggle" HorizontalAlignment="Left" Background="#D0BCF6" BorderBrush="#D0BCF6" Foreground="#231B31"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="#202125" CornerRadius="13" BorderBrush="#35363A" BorderThickness="1" Padding="15" Margin="6,0,0,0">
     <StackPanel>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="&#xE7F4;" Style="{StaticResource SidebarIcon}" Foreground="#C5ACEF"/>
       <TextBlock Text="Оверлей" FontSize="15" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock x:Name="OverlayStatus" Foreground="{StaticResource Muted}" Margin="0,5,0,10" FontSize="12"/>
      <StackPanel Orientation="Horizontal">
       <Button x:Name="OverlayToggle" Margin="0,0,6,0"/>
       <Button x:Name="MoveOverlay" Content="Переместить"/>
      </StackPanel>
     </StackPanel>
    </Border>
   </Grid>
   <TextBlock Grid.Row="3" x:Name="Feedback" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,11,0,0"
              TextWrapping="Wrap" Text="Оверлей работает в режиме Fortnite «Окно на весь экран»."/>
  </Grid>
 </Grid>
</Window>
