<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chest Island" Width="740" Height="594" MinWidth="640" MinHeight="565" WindowStartupLocation="CenterScreen" Background="#111116" Foreground="#F5F2FB" FontFamily="Segoe UI">
<Window.Resources>
 <Style TargetType="Button">
  <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="14,0"/><Setter Property="Foreground" Value="#F5F2FB"/><Setter Property="Background" Value="#343041"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Panel" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Panel" Property="Opacity" Value="0.78"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Panel" Property="Opacity" Value="0.55"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Panel" Property="BorderBrush" Value="#F5F2FB"/><Setter TargetName="Panel" Property="BorderThickness" Value="1"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Panel" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</Window.Resources>
<Grid x:Name="Dashboard" Margin="26,20">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,16">
  <Border DockPanel.Dock="Right" CornerRadius="16" Background="#25232E" Padding="12,6" VerticalAlignment="Center"><TextBlock x:Name="Game" FontSize="12" Foreground="#D3CBE0"/></Border>
  <StackPanel><TextBlock Text="Chest Island" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Счётчик сундуков Fortnite" Foreground="#B3ADC2" FontSize="13"/></StackPanel>
 </DockPanel>
 <Border Grid.Row="1" CornerRadius="25" BorderBrush="#514367" BorderThickness="1" Margin="0,0,0,13">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#342648" Offset="0"/><GradientStop Color="#231D34" Offset="0.55"/><GradientStop Color="#171821" Offset="1"/></LinearGradientBrush></Border.Background>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
   <TextBlock Text="ВСЕГО СУНДУКОВ" Foreground="#D8C4FD" FontSize="12" FontWeight="SemiBold"/>
   <TextBlock x:Name="Count" Text="0" FontSize="72" FontWeight="SemiBold" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><ScaleTransform/></TextBlock.RenderTransform></TextBlock>
   <TextBlock x:Name="Session" Foreground="#C6BED4" FontSize="13"/>
   <TextBlock x:Name="GoalLabel" Text="Цель не задана" Foreground="#D8C4FD" FontSize="13" Margin="0,8,0,5"/>
   <ProgressBar x:Name="GoalProgress" Width="218" Height="5" Maximum="1" Foreground="#D4B7FF" Background="#43384F" BorderThickness="0" Visibility="Collapsed"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
    <Button x:Name="EditCount" Content="Изменить счёт" Height="30" Margin="0,0,6,0"/>
    <Button x:Name="EditGoal" Content="Цель" Height="30" Margin="0,0,6,0"/>
    <Button x:Name="History" Content="История" Height="30"/>
   </StackPanel>
  </StackPanel>
 </Border>
 <Grid Grid.Row="2">
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#1D1B26" CornerRadius="18" Padding="14" Margin="0,0,6,0">
   <StackPanel>
    <TextBlock Text="Распознавание" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock x:Name="LiveStatus" Foreground="#B7AFC7" Margin="0,4,0,10"/>
    <Button x:Name="LiveToggle" HorizontalAlignment="Left" Background="#D4B7FF" Foreground="#241532"/>
   </StackPanel>
  </Border>
  <Border Grid.Column="1" Background="#1D1B26" CornerRadius="18" Padding="14" Margin="6,0,0,0">
   <StackPanel>
    <TextBlock Text="Оверлей" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock x:Name="OverlayStatus" Foreground="#B7AFC7" Margin="0,4,0,10"/>
    <StackPanel Orientation="Horizontal"><Button x:Name="OverlayToggle" Margin="0,0,8,0"/><Button x:Name="MoveOverlay" Content="Переместить"/></StackPanel>
   </StackPanel>
  </Border>
 </Grid>
  <DockPanel Grid.Row="3" Margin="0,10,0,0">
  <Button x:Name="SettingsButton" DockPanel.Dock="Right" Height="30" Content="Настройки"/>
  <Button x:Name="UpdateButton" DockPanel.Dock="Right" Height="30" Margin="8,0,8,0" Content="Проверить обновления"/>
  <TextBlock x:Name="Feedback" VerticalAlignment="Center" Foreground="#BDB5CD" TextWrapping="Wrap" Text="Для оверлея выбери в Fortnite режим «Окно на весь экран»."/>
 </DockPanel>
</Grid>
</Window>
